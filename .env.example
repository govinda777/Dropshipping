# -----------------------------------------------------------------------------
# Dropshipping Application - Environment Variables Template
# Copy this file to .env or .env.local and fill in the values
# -----------------------------------------------------------------------------

# Database configuration (e.g. Neon PostgreSQL, local Postgres, etc.)
DATABASE_URL="postgresql://username:password@localhost:5432/dropshipping_db"

# Google Gemini API Key for AI operations
GEMINI_API_KEY="your_gemini_api_key_here"

# AliExpress Open Platform Credentials
ALIEXPRESS_APP_KEY="your_aliexpress_app_key_here"
ALIEXPRESS_APP_SECRET="your_aliexpress_app_secret_here"
ALIEXPRESS_SESSION_KEY="your_aliexpress_session_key_here"

# Gateway Integration Token
GATEWAY_ACCESS_TOKEN="your_gateway_access_token_here"

# Frontend Public Variables
NEXT_PUBLIC_PRIVY_APP_ID="your_privy_app_id_here"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
