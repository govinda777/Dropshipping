{
  "name": "n8n Webhook IA Content Generation & TikTok Automation",
  "nodes": [
    {
      "parameters": {
        "path": "sanity-webhook",
        "responseMode": "lastNode",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "sanity-webhook-id"
    },
    {
      "parameters": {
        "model": "gemini-2.5-flash",
        "prompt": "Aja como um especialista técnico em montanhismo e Copywriter sênior de E-commerce.\nVocê recebeu a imagem de um produto e o título de contexto: \"{{$node[\"Webhook\"].json[\"title\"]}}\".\n\nGere um output estritamente em formato JSON contendo duas chaves:\n1. \"description\": Uma descrição técnica e persuasiva em formato Markdown. Destaque atributos de segurança essenciais para escaladores. Use bullet points.\n2. \"slug\": Um slug amigável para SEO baseado no título (ex: kit-magnesio-liquido-escalada).\n\nRetorne APENAS o JSON bruto, sem blocos de código markdown.",
        "jsonOutput": true
      },
      "name": "Gemini",
      "type": "n8n-nodes-base.googleGemini",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.topview.ai/v1/video/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{TOPVIEW_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "media_urls",
              "value": "[\"{{$node[\"Webhook\"].json[\"imageUrl\"]}}\"]"
            },
            {
              "name": "script_prompt",
              "value": "Crie um vídeo dinâmico para o TikTok focado em escaladores do nicho esportivo e tradicional, demonstrando os benefícios de segurança e performance de: {{$node[\"Webhook\"].json[\"title\"]}}. Use hashtags relevantes como #escalada #rockclimbing"
            },
            {
              "name": "aspect_ratio",
              "value": "9:16"
            },
            {
              "name": "avatar_id",
              "value": "realistic_athlete_01"
            }
          ]
        }
      },
      "name": "TopView API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [650, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://{{PROJECT_ID}}.api.sanity.io/v1/data/mutate/{{DATASET}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{SANITY_WRITE_TOKEN}}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "mutations",
              "value": "[\n    {\n      \"patch\": {\n        \"id\": \"{{$node[\"Webhook\"].json[\"id\"]}}\",\n        \"set\": {\n          \"descriptionHtml\": \"{{$node[\"Gemini\"].json[\"description\"]}}\",\n          \"slug\": { \"_type\": \"slug\", \"current\": \"{{$node[\"Gemini\"].json[\"slug\"]}}\" }\n        }\n      }\n    }\n  ]"
            }
          ]
        }
      },
      "name": "Sanity Update",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [650, 400]
    },
    {
      "parameters": {
        "operation": "upload",
        "videoUrl": "={{$node[\"TopView API\"].json[\"video_url\"]}}",
        "description": "Veja esse equipamento essencial para suas escaladas: {{$node[\"Webhook\"].json[\"title\"]}}! Link na Bio! #escalada #rockclimbing #equipamento",
        "privacyLevel": "public",
        "disableComment": false,
        "disableDuet": false,
        "disableStitch": false
      },
      "name": "TikTok Publishing",
      "type": "n8n-nodes-base.tiktok",
      "typeVersion": 1,
      "position": [850, 200]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Gemini",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini": {
      "main": [
        [
          {
            "node": "TopView API",
            "type": "main",
            "index": 0
          },
          {
            "node": "Sanity Update",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "TopView API": {
      "main": [
        [
          {
            "node": "TikTok Publishing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}